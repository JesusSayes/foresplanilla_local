{
  "name": "Sincronizar Asistencia por Vacaci\u00f3n Aprobada",
  "description": "Al aprobar una solicitud de vacaciones (status \u2192 Aprobada/Aprobado), sobrescribe los registros de asistencia cubiertos para que no generen descuento por tardanza/inasistencia en planilla.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Aprobada\" or .trigger.data.status == \"Aprobado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "VacationRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sincronizar_asistencia_por_vacaci_n_aprobada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarAsistenciaVacacion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sincronizarAsistenciaVacacion"
  }
}