{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asistencia"
    },
    "clock_in": {
      "type": "string",
      "description": "Hora de entrada segmento 1 (HH:mm)"
    },
    "clock_out": {
      "type": "string",
      "description": "Hora de salida segmento 1 (HH:mm)"
    },
    "clock_in_2": {
      "type": "string",
      "description": "Hora de entrada segmento 2 (HH:mm)"
    },
    "clock_out_2": {
      "type": "string",
      "description": "Hora de salida segmento 2 (HH:mm)"
    },
    "clock_in_3": {
      "type": "string",
      "description": "Hora de entrada segmento 3 (HH:mm)"
    },
    "clock_out_3": {
      "type": "string",
      "description": "Hora de salida segmento 3 (HH:mm)"
    },
    "clock_in_4": {
      "type": "string",
      "description": "Hora de entrada segmento 4 (HH:mm)"
    },
    "clock_out_4": {
      "type": "string",
      "description": "Hora de salida segmento 4 (HH:mm)"
    },
    "segment_count": {
      "type": "integer",
      "default": 1,
      "description": "N\u00famero de segmentos de trabajo del d\u00eda (1\u20134)"
    },
    "is_split_day": {
      "type": "boolean",
      "default": false,
      "description": "True si el d\u00eda tiene m\u00e1s de un segmento de trabajo"
    },
    "scheduled_start": {
      "type": "string",
      "default": "09:00",
      "description": "Hora programada de entrada"
    },
    "scheduled_end": {
      "type": "string",
      "default": "18:00",
      "description": "Hora programada de salida"
    },
    "worked_hours": {
      "type": "number",
      "description": "Horas trabajadas totales (incluyendo extras)"
    },
    "regular_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas dentro del horario normal"
    },
    "overtime_hours_25": {
      "type": "number",
      "default": 0,
      "description": "Horas extras al 25% (primeras 2h extra del d\u00eda)"
    },
    "overtime_hours_35": {
      "type": "number",
      "default": 0,
      "description": "Horas extras al 35% (a partir de la 3ra hora extra)"
    },
    "overtime_authorized": {
      "type": "boolean",
      "default": false,
      "description": "Horas extras aceptadas/autorizadas para este d\u00eda espec\u00edfico"
    },
    "is_late": {
      "type": "boolean",
      "default": false,
      "description": "Lleg\u00f3 tarde"
    },
    "late_minutes": {
      "type": "integer",
      "default": 0,
      "description": "Minutos de tardanza"
    },
    "is_absent": {
      "type": "boolean",
      "default": false,
      "description": "Falta"
    },
    "status": {
      "type": "string",
      "enum": [
        "Completo",
        "Incompleto",
        "Ausente",
        "Justificado",
        "Vacaciones",
        "Compensaci\u00f3n"
      ],
      "default": "Completo",
      "description": "Estado del registro"
    },
    "notes": {
      "type": "string",
      "description": "Observaciones"
    },
    "manually_protected_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de campos protegidos de sobrescritura autom\u00e1tica"
    },
    "last_approved_edit_id": {
      "type": "string",
      "description": "ID de la \u00faltima solicitud de edici\u00f3n aprobada"
    },
    "manually_modified_by": {
      "type": "string",
      "description": "Nombre de quien realiz\u00f3 la \u00faltima modificaci\u00f3n manual aprobada"
    },
    "manually_modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima modificaci\u00f3n manual aprobada"
    }
  },
  "required": [
    "employee_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_all_attendance": true
          }
        },
        {
          "data.employee_id": "{{user.data.employee_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        }
      ]
    }
  }
}