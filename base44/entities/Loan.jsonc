{
  "name": "Loan",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "loan_type_id": {
      "type": "string",
      "description": "ID del tipo de pr\u00e9stamo"
    },
    "amount": {
      "type": "number",
      "description": "Monto total del pr\u00e9stamo"
    },
    "total_installments": {
      "type": "integer",
      "description": "Total de cuotas mensuales"
    },
    "installments_paid": {
      "type": "integer",
      "default": 0,
      "description": "Cuotas pagadas"
    },
    "monthly_amount": {
      "type": "number",
      "description": "Monto mensual a descontar"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio del descuento"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha estimada de fin"
    },
    "status": {
      "type": "string",
      "enum": [
        "Activo",
        "Pagado",
        "Cancelado"
      ],
      "default": "Activo",
      "description": "Estado del pr\u00e9stamo"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "approved_by": {
      "type": "string",
      "description": "Email de quien aprob\u00f3"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de aprobaci\u00f3n"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Eliminaci\u00f3n l\u00f3gica: si es true, el pr\u00e9stamo se conserva en la base de datos pero deja de mostrarse en la gesti\u00f3n y sus cuotas no se descuentan en planilla"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la eliminaci\u00f3n l\u00f3gica"
    },
    "deleted_by": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 la eliminaci\u00f3n l\u00f3gica"
    }
  },
  "required": [
    "employee_id",
    "loan_type_id",
    "amount",
    "total_installments",
    "monthly_amount",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_loans": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_loans": true
          }
        },
        {
          "data.employee_id": "{{user.data.employee_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_loans": true
          }
        },
        {
          "user_condition": {
            "data.can_create_payroll": true
          }
        },
        {
          "user_condition": {
            "data.can_edit_payroll": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_loans": true
          }
        }
      ]
    }
  }
}