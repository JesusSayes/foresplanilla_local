{
  "name": "ContractTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string",
      "description": "Nombre de la plantilla"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la plantilla"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Plantilla por defecto"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Plantilla activa"
    },
    "contract_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de contrato aplicables"
    },
    "company_name": {
      "type": "string",
      "description": "Raz\u00f3n social de la empresa"
    },
    "company_ruc": {
      "type": "string",
      "description": "RUC de la empresa"
    },
    "company_address": {
      "type": "string",
      "description": "Direcci\u00f3n de la empresa"
    },
    "company_representative": {
      "type": "string",
      "description": "Representante legal"
    },
    "company_representative_doc": {
      "type": "string",
      "description": "Documento del representante"
    },
    "contract_title": {
      "type": "string",
      "description": "T\u00edtulo principal del contrato"
    },
    "contract_subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo del contrato"
    },
    "employer_section_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n empleador (sin numeral, se auto-numera al renderizar)"
    },
    "employer_section_text": {
      "type": "string",
      "description": "Contenido secci\u00f3n empleador"
    },
    "worker_section_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n trabajador (sin numeral, se auto-numera al renderizar)"
    },
    "worker_section_text": {
      "type": "string",
      "description": "Contenido secci\u00f3n trabajador"
    },
    "introduction_text": {
      "type": "string",
      "description": "Texto introductorio del contrato"
    },
    "section_object_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Objeto del Contrato (sin numeral, se auto-numera)"
    },
    "contract_object_text": {
      "type": "string",
      "description": "Texto del objeto del contrato"
    },
    "section_functions_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Funciones y Responsabilidades (sin numeral, se auto-numera)"
    },
    "functions_intro_text": {
      "type": "string",
      "description": "Introducci\u00f3n a las funciones"
    },
    "section_duration_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Vigencia del Contrato (sin numeral, se auto-numera)"
    },
    "duration_indeterminate_text": {
      "type": "string",
      "description": "Texto de vigencia para contrato indeterminado"
    },
    "duration_fixed_text": {
      "type": "string",
      "description": "Texto de vigencia para contrato plazo fijo"
    },
    "trial_period_text": {
      "type": "string",
      "description": "Texto del per\u00edodo de prueba"
    },
    "section_salary_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Remuneraci\u00f3n (sin numeral, se auto-numera)"
    },
    "salary_text": {
      "type": "string",
      "description": "Texto de remuneraci\u00f3n"
    },
    "section_schedule_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Jornada y Horario (sin numeral, se auto-numera)"
    },
    "schedule_text": {
      "type": "string",
      "description": "Texto de jornada y horario"
    },
    "work_location_text": {
      "type": "string",
      "description": "Texto de lugar de trabajo"
    },
    "section_obligations_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Obligaciones del Trabajador (sin numeral, se auto-numera)"
    },
    "obligations_text": {
      "type": "string",
      "description": "Obligaciones del trabajador"
    },
    "section_benefits_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Beneficios Sociales (sin numeral, se auto-numera)"
    },
    "benefits_text": {
      "type": "string",
      "description": "Beneficios sociales"
    },
    "section_termination_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n T\u00e9rmino del Contrato (sin numeral, se auto-numera)"
    },
    "termination_text": {
      "type": "string",
      "description": "T\u00e9rmino del contrato"
    },
    "section_domicile_title": {
      "type": "string",
      "description": "T\u00edtulo secci\u00f3n Domicilio (sin numeral, se auto-numera)"
    },
    "domicile_text": {
      "type": "string",
      "description": "Texto de domicilio"
    },
    "unified_clause_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Orden unificado de TODAS las cl\u00e1usulas (est\u00e1ndar y personalizadas) en una sola lista. Contiene IDs est\u00e1ndar (object, functions, duration, salary, schedule) mezclados con IDs de cl\u00e1usulas personalizadas (ContractClause.id). Define el orden de aparici\u00f3n y la numeraci\u00f3n autom\u00e1tica continua. Permite insertar cl\u00e1usulas personalizadas en cualquier posici\u00f3n, incluso antes de las cl\u00e1usulas est\u00e1ndar."
    },
    "standard_clause_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "[DEPRECATED] Orden legacy de las cl\u00e1usulas est\u00e1ndar. Reemplazado por 'unified_clause_order'. Se conserva solo para compatibilidad de lectura durante la transici\u00f3n."
    },
    "final_text_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Orden de los textos finales (IDs: obligations, benefits, termination, domicile). Define el orden de aparici\u00f3n y la numeraci\u00f3n autom\u00e1tica continua despu\u00e9s de las cl\u00e1usulas (est\u00e1ndar + personalizadas)."
    }
  },
  "required": [
    "template_name"
  ]
}