{
  "name": "PayrollConfig",
  "type": "object",
  "properties": {
    "config_type": {
      "type": "string",
      "enum": [
        "Quincenal",
        "General"
      ],
      "default": "Quincenal",
      "description": "Tipo de configuraci\u00f3n"
    },
    "quincenal_percentage": {
      "type": "number",
      "default": 40,
      "description": "Porcentaje del sueldo base para planilla quincenal (ej: 40 para 40%)"
    },
    "quincenal_cutoff_day": {
      "type": "integer",
      "default": 7,
      "description": "D\u00eda l\u00edmite de ingreso para incluir en planilla quincenal (trabajadores que ingresaron hasta este d\u00eda del mes)"
    },
    "enable_tardiness_compensation": {
      "type": "boolean",
      "default": false,
      "description": "Habilita la compensaci\u00f3n manual de tardanzas con minutos adicionales trabajados despu\u00e9s de la hora programada de salida. Deshabilitado por defecto: si est\u00e1 en false, todo funciona exactamente como actualmente. Cuando est\u00e1 en true, personal autorizado de RRHH puede compensar tardanzas expl\u00edcitamente desde la pantalla de asistencia."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Configuraci\u00f3n activa"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "config_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_all_payroll": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    }
  }
}