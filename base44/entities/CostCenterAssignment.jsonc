{
  "name": "CostCenterAssignment",
  "type": "object",
  "properties": {
    "cost_center_id": {
      "type": "string",
      "description": "ID del centro de costos"
    },
    "assignment_type": {
      "type": "string",
      "enum": [
        "Empleado",
        "Departamento"
      ],
      "description": "Tipo de asignaci\u00f3n"
    },
    "employee_id": {
      "type": "string",
      "description": "ID del empleado (si es asignaci\u00f3n individual)"
    },
    "department_name": {
      "type": "string",
      "description": "Nombre del departamento (si es asignaci\u00f3n departamental)"
    },
    "percentage": {
      "type": "number",
      "default": 100,
      "description": "Porcentaje de distribuci\u00f3n (para casos de asignaci\u00f3n parcial)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio de la asignaci\u00f3n"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin de la asignaci\u00f3n"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Asignaci\u00f3n activa"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "cost_center_id",
    "assignment_type",
    "start_date"
  ]
}