{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "role_id": {
      "type": "string",
      "description": "ID del rol"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email de quien asign\u00f3 el rol"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de asignaci\u00f3n"
    }
  },
  "required": [
    "employee_id",
    "role_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_roles": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_roles": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_roles": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_roles": true
          }
        }
      ]
    }
  }
}