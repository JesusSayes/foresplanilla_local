{
  "name": "ConfiguracionContable",
  "type": "object",
  "properties": {
    "empresa_codigo": {
      "type": "string",
      "description": "C\u00f3digo de empresa (001, 002 prueba; 003 final)"
    },
    "tipo_mapeo": {
      "type": "string",
      "enum": [
        "concepto_planilla",
        "origen_asiento",
        "tipo_planilla"
      ],
      "description": "Tipo de mapeo: concepto de planilla, origen de asiento o tipo de planilla"
    },
    "clave": {
      "type": "string",
      "description": "Clave del concepto/origen/tipo (ej: 'Mensual', 'SNP', 'remuneracion_base', 'Planilla')"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n legible del mapeo (ej: 'Remuneraci\u00f3n (Debe)')"
    },
    "cuenta": {
      "type": "string",
      "description": "C\u00f3digo de cuenta contable PCGE (ref. CuentaContable.cuenta)"
    },
    "debe_haber": {
      "type": "string",
      "enum": [
        "D",
        "H"
      ],
      "description": "D=Debe, H=Haber"
    },
    "subdiario": {
      "type": "string",
      "description": "C\u00f3digo de subdiario por defecto para este mapeo"
    },
    "centro_costos": {
      "type": "string",
      "description": "C\u00f3digo de centro de costos por defecto"
    },
    "orden": {
      "type": "integer",
      "default": 0,
      "description": "Orden de la l\u00ednea dentro del mapeo"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Mapeo activo"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "empresa_codigo",
    "tipo_mapeo",
    "clave",
    "cuenta",
    "debe_haber"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_accounting": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        }
      ]
    }
  }
}