{
  "name": "StarsoftConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "default": "Configuraci\u00f3n Starsoft",
      "description": "Nombre identificador de la configuraci\u00f3n"
    },
    "client_id": {
      "type": "string",
      "description": "ClientID generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "client_secret": {
      "type": "string",
      "description": "ClientSecret generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "cod_empresa": {
      "type": "string",
      "default": "003",
      "description": "C\u00f3digo de empresa Starsoft destino. 003 es producci\u00f3n (valor fijo). Para pruebas puede ser cualquier c\u00f3digo editable (001, 002, 04, 06, etc.)."
    },
    "cod_sistema": {
      "type": "string",
      "default": "01",
      "description": "C\u00f3digo del sistema Starsoft enviado en la autenticaci\u00f3n"
    },
    "auth_url": {
      "type": "string",
      "description": "URL del endpoint de autenticaci\u00f3n de Starsoft (POST con clientID, clientSecret, codEmpresa, codSistema)"
    },
    "api_url": {
      "type": "string",
      "description": "URL del endpoint de env\u00edo/migraci\u00f3n de asientos contables de Starsoft (POST con Bearer token)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Configuraci\u00f3n activa (se usa la primera activa para migrar)"
    },
    "cuentas_por_planilla": {
      "type": "array",
      "description": "Lista de cuentas contables por tipo de contrato. Cada registro vincula un tipo de contrato (igual al combo 'Tipo de Contrato' del formulario de empleados) con una cuenta contable y su rol (Debe o Haber). Para configurar un tipo de contrato completo se agregan dos registros: uno del DEBE (gasto) y uno del HABER (neto a pagar / descuentos). La generaci\u00f3n de asientos resuelve las cuentas seg\u00fan el tipo de contrato de cada empleado. Las cuentas se seleccionan desde la tabla Cuentas Contables (Datos Maestros).",
      "items": {
        "type": "object",
        "properties": {
          "tipo_planilla": {
            "type": "string",
            "enum": [
              "Indeterminado",
              "Plazo Fijo",
              "Part-Time",
              "Pr\u00e1cticas",
              "SNP"
            ],
            "description": "Tipo de contrato al que aplica la cuenta (mismos valores que el combo 'Tipo de Contrato' del formulario de empleados)"
          },
          "cuenta": {
            "type": "string",
            "description": "C\u00f3digo de cuenta contable (ref. CuentaContable.cuenta)"
          },
          "debe_haber": {
            "type": "string",
            "enum": [
              "D",
              "H"
            ],
            "description": "D=Debe (gasto de personal / honorarios brutos) / H=Haber (neto a pagar y descuentos/tributos)"
          }
        },
        "required": [
          "tipo_planilla",
          "cuenta",
          "debe_haber"
        ]
      }
    },
    "last_test_status": {
      "type": "string",
      "enum": [
        "",
        "success",
        "error"
      ],
      "default": "",
      "description": "Resultado de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_message": {
      "type": "string",
      "description": "Mensaje devuelto en la \u00faltima prueba de conexi\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "cod_empresa",
    "auth_url",
    "api_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_view_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    }
  }
}