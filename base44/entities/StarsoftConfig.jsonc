{
  "name": "StarsoftConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "default": "Configuraci\u00f3n Starsoft",
      "description": "Nombre identificador de la configuraci\u00f3n"
    },
    "client_id": {
      "type": "string",
      "description": "ClientID generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "client_secret": {
      "type": "string",
      "description": "ClientSecret generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "cod_empresa": {
      "type": "string",
      "default": "003",
      "description": "C\u00f3digo de empresa Starsoft destino. 003 es producci\u00f3n (valor fijo). Para pruebas puede ser cualquier c\u00f3digo editable (001, 002, 04, 06, etc.)."
    },
    "cod_sistema": {
      "type": "string",
      "default": "01",
      "description": "C\u00f3digo del sistema Starsoft enviado en la autenticaci\u00f3n"
    },
    "auth_url": {
      "type": "string",
      "description": "URL del endpoint de autenticaci\u00f3n de Starsoft (POST con clientID, clientSecret, codEmpresa, codSistema)"
    },
    "api_url": {
      "type": "string",
      "description": "URL del endpoint de env\u00edo/migraci\u00f3n de asientos contables de Starsoft (POST con Bearer token)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Configuraci\u00f3n activa (se usa la primera activa para migrar)"
    },
    "cuentas_por_planilla": {
      "type": "object",
      "description": "Configuraci\u00f3n de cuentas contables (debe/haber) seg\u00fan el tipo de planilla. Las cuentas se seleccionan desde la tabla Cuentas Contables (Datos Maestros). Estructura: { regular: { cuenta_debe, cuenta_haber_neto, cuenta_haber_descuentos }, snp: { cuenta_debe, cuenta_haber_neto, cuenta_haber_descuentos } }",
      "properties": {
        "regular": {
          "type": "object",
          "description": "Planilla de remuneraciones de plazo fijo (Quincenal, Mensual, Adicional)",
          "properties": {
            "cuenta_debe": {
              "type": "string",
              "description": "Cuenta del DEBE (gasto de sueldos/salarios)"
            },
            "cuenta_haber_neto": {
              "type": "string",
              "description": "Cuenta del HABER para el neto a pagar (remuneraciones por pagar)"
            },
            "cuenta_haber_descuentos": {
              "type": "string",
              "description": "Cuenta del HABER para descuentos/tributos (ESSALUD/AFP/etc.)"
            }
          }
        },
        "snp": {
          "type": "object",
          "description": "Servicios No Personales / Honorarios (Recibos de Honorarios)",
          "properties": {
            "cuenta_debe": {
              "type": "string",
              "description": "Cuenta del DEBE (servicios de terceros - honorarios brutos)"
            },
            "cuenta_haber_neto": {
              "type": "string",
              "description": "Cuenta del HABER para el neto a pagar (honorarios por pagar)"
            },
            "cuenta_haber_descuentos": {
              "type": "string",
              "description": "Cuenta del HABER para retenciones de 4ta categor\u00eda"
            }
          }
        }
      }
    },
    "last_test_status": {
      "type": "string",
      "enum": [
        "",
        "success",
        "error"
      ],
      "default": "",
      "description": "Resultado de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_message": {
      "type": "string",
      "description": "Mensaje devuelto en la \u00faltima prueba de conexi\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "cod_empresa",
    "auth_url",
    "api_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_view_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    }
  }
}