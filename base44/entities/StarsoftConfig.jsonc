{
  "name": "StarsoftConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "default": "Configuraci\u00f3n Starsoft",
      "description": "Nombre identificador de la configuraci\u00f3n"
    },
    "client_id": {
      "type": "string",
      "description": "ClientID generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "client_secret": {
      "type": "string",
      "description": "ClientSecret generado en Starsoft para el uso de las APIs de migraci\u00f3n de asientos"
    },
    "cod_empresa": {
      "type": "string",
      "default": "003",
      "description": "C\u00f3digo de empresa Starsoft destino. 003 es producci\u00f3n (valor fijo). Para pruebas puede ser cualquier c\u00f3digo editable (001, 002, 04, 06, etc.)."
    },
    "cod_sistema": {
      "type": "string",
      "default": "01",
      "description": "C\u00f3digo del sistema Starsoft enviado en la autenticaci\u00f3n"
    },
    "auth_url": {
      "type": "string",
      "description": "URL del endpoint de autenticaci\u00f3n de Starsoft (POST con clientID, clientSecret, codEmpresa, codSistema)"
    },
    "api_url": {
      "type": "string",
      "description": "URL del endpoint de env\u00edo/migraci\u00f3n de asientos contables de Starsoft (POST con Bearer token)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Configuraci\u00f3n activa (se usa la primera activa para migrar)"
    },
    "cuentas_por_planilla": {
      "type": "array",
      "description": "[DEPRECATED] Configuraci\u00f3n legacy de cuentas por tipo de contrato. Reemplazada por 'cuentas_por_concepto'. Se conserva solo para compatibilidad de lectura durante la transici\u00f3n.",
      "items": {
        "type": "object",
        "properties": {
          "tipo_planilla": {
            "type": "string"
          },
          "cuenta": {
            "type": "string"
          },
          "debe_haber": {
            "type": "string",
            "enum": [
              "D",
              "H"
            ]
          }
        }
      }
    },
    "cuentas_por_concepto": {
      "type": "array",
      "description": "Homologaci\u00f3n de cuentas contables por concepto PLAME. Cada registro vincula un concepto (c\u00f3digo PLAME + nombre) con una cuenta contable y su lado (Debe o Haber). Reemplaza la anterior configuraci\u00f3n por tipo de contrato y permite configurar ingresos, descuentos, aportaciones del empleador y neto a pagar en una sola tabla. La generaci\u00f3n de asientos resuelve las cuentas por c\u00f3digo de concepto (o por nombre como respaldo) leyendo el calculation_summary de cada boleta. La categor\u00eda 'Neto' (lado H) define la cuenta del neto a pagar. Las cuentas se seleccionan desde la tabla Cuentas Contables (Datos Maestros).",
      "items": {
        "type": "object",
        "properties": {
          "codigo_plame": {
            "type": "string",
            "description": "C\u00f3digo PLAME del concepto (ej: 0121, 0201, 1004). Debe coincidir con el concept_code del calculation_summary."
          },
          "concepto": {
            "type": "string",
            "description": "Nombre descriptivo del concepto (ej: Remuneraci\u00f3n b\u00e1sica, Asignaci\u00f3n familiar)"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "Ingreso",
              "Descuento",
              "Aportaci\u00f3n",
              "Neto"
            ],
            "description": "Categor\u00eda del concepto: Ingreso (DEBE gasto), Descuento (HABER), Aportaci\u00f3n (aporte del empleador), Neto (HABER neto a pagar)"
          },
          "cuenta": {
            "type": "string",
            "description": "C\u00f3digo de cuenta contable (ref. CuentaContable.cuenta)"
          },
          "debe_haber": {
            "type": "string",
            "enum": [
              "D",
              "H"
            ],
            "description": "D=Debe / H=Haber"
          }
        },
        "required": [
          "codigo_plame",
          "concepto",
          "categoria",
          "cuenta",
          "debe_haber"
        ]
      }
    },
    "last_test_status": {
      "type": "string",
      "enum": [
        "",
        "success",
        "error"
      ],
      "default": "",
      "description": "Resultado de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de la \u00faltima prueba de conexi\u00f3n"
    },
    "last_test_message": {
      "type": "string",
      "description": "Mensaje devuelto en la \u00faltima prueba de conexi\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "cod_empresa",
    "auth_url",
    "api_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_view_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_accounting": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_system": true
          }
        }
      ]
    }
  }
}