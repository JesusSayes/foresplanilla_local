{
  "name": "AttendanceIncident",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "ID del empleado"
    },
    "attendance_record_id": {
      "type": "string",
      "description": "ID del registro de asistencia"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la incidencia"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "Comisi\u00f3n de Servicio",
        "Capacitaci\u00f3n",
        "Descanso M\u00e9dico",
        "Omisi\u00f3n de Marcaci\u00f3n",
        "Cita M\u00e9dica",
        "Confirmaci\u00f3n de Asistencia (Limitaci\u00f3n de Sistema)",
        "Licencia por Maternidad",
        "Licencia por Paternidad",
        "Otro",
        "Onom\u00e1stico",
        "Descanso Vacacional",
        "Licencia sin Goce de Haber",
        "Feriado",
        "Justificaci\u00f3n de Tardanza",
        "Tardanza",
        "Falta",
        "Salida Temprana",
        "Compensaci\u00f3n de Tardanza"
      ],
      "description": "Tipo de incidencia"
    },
    "justification": {
      "type": "string",
      "description": "Justificaci\u00f3n de la incidencia"
    },
    "supporting_document_url": {
      "type": "string",
      "description": "URL del documento de sustento"
    },
    "justified_time_start": {
      "type": "string",
      "description": "Hora de inicio del per\u00edodo justificado (HH:mm)"
    },
    "justified_time_end": {
      "type": "string",
      "description": "Hora de fin del per\u00edodo justificado (HH:mm)"
    },
    "full_day_justification": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, se justifica todo el d\u00eda"
    },
    "hours_to_adjust": {
      "type": "number",
      "default": 0,
      "description": "Horas calculadas a ajustar (sin incluir extras)"
    },
    "overtime_minutes_25": {
      "type": "integer",
      "default": 0,
      "description": "Minutos de HE al 25% destinados a compensaci\u00f3n de tardanza. Se descuentan del total de HE al 25% en el c\u00e1lculo de planilla para que no generen pago (solo la parte no destinada a compensaci\u00f3n se paga). Se consumen primero del total disponible al 25%."
    },
    "overtime_minutes_35": {
      "type": "integer",
      "default": 0,
      "description": "Minutos de HE al 35% destinados a compensaci\u00f3n de tardanza. Se descuentan del total de HE al 35% en el c\u00e1lculo de planilla para que no generen pago. Se consumen despu\u00e9s de agotar los minutos al 25%."
    },
    "late_minutes_to_adjust": {
      "type": "integer",
      "default": 0,
      "description": "Minutos de tardanza a ajustar"
    },
    "authorizer_id": {
      "type": "string",
      "description": "ID del empleado designado como autorizador de la compensaci\u00f3n"
    },
    "authorizer_name": {
      "type": "string",
      "description": "Nombre del empleado que debe autorizar la compensaci\u00f3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobada",
        "Rechazada"
      ],
      "default": "Pendiente",
      "description": "Estado de la justificaci\u00f3n"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Nombre de quien revis\u00f3"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de revisi\u00f3n"
    },
    "review_comments": {
      "type": "string",
      "description": "Comentarios de la revisi\u00f3n"
    },
    "codigo_solicitud": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de la solicitud. Agrupa los incidentes de un mismo pedido multi-fecha (y los de un solo d\u00eda) para permitir aprobaci\u00f3n/rechazo por periodo completo. Los incidentes hist\u00f3ricos sin c\u00f3digo se tratan como grupos unitarios."
    },
    "citt_number": {
      "type": "string",
      "description": "OPCIONAL. N\u00famero del Certificado de Incapacidad Temporal para el Trabajo (CITT) cuando corresponde. Solo aplica a descansos m\u00e9dicos; se conserva como sustento del subsidio y para la conciliaci\u00f3n PLAME. No se usa para diagn\u00f3sticos."
    },
    "citt_status": {
      "type": "string",
      "enum": [
        "",
        "Pendiente",
        "Validado",
        "No aplica"
      ],
      "default": "",
      "description": "OPCIONAL. Estado del sustento del descanso m\u00e9dico: vac\u00edo/sin definir, Pendiente (certificado privado o CITT no disponible), Validado (CITT validado/canjeado) o No aplica. Un CITT pendiente NO convierte el descanso en falta ni en licencia sin goce: solo se\u00f1ala documentaci\u00f3n por regularizar."
    },
    "subsidy_daily_base": {
      "type": "number",
      "description": "OPCIONAL. Base diaria del subsidio por incapacidad temporal sustentada por un usuario autorizado cuando falta historial de remuneraciones computables. Si tiene valor, la planilla usa esta base en lugar del promedio hist\u00f3rico y deja registro del sustento."
    },
    "subsidy_daily_base_reason": {
      "type": "string",
      "description": "OPCIONAL. Sustento documentado de la base diaria del subsidio registrada manualmente (fuente, per\u00edodo e importes)."
    }
  },
  "required": [
    "employee_id",
    "incident_date",
    "incident_type",
    "justification"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        },
        {
          "data.employee_id": "{{user.data.employee_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_view_all_attendance": true
          }
        },
        {
          "data.employee_id": "{{user.data.employee_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_approve_attendance_incidents": true
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.can_manage_attendance": true
          }
        }
      ]
    }
  }
}