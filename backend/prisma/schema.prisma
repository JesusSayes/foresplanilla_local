  payroll_type       String?
  payroll_number     String?
  advance_payment_id String?
  worked_days        Int?
  non_worked_days    Int?
  subsidized_days    Int?
  regular_hours      Decimal?  @db.Decimal(18, 2)
  overtime_hours     Decimal?  @db.Decimal(18, 2)
  base_salary        Decimal?  @db.Decimal(18, 2)
  family_allowance   Decimal?  @db.Decimal(18, 2)
  overtime_pay       Decimal?  @db.Decimal(18, 2)
  bonuses            Decimal?  @db.Decimal(18, 2)
  commissions        Decimal?  @db.Decimal(18, 2)
  other_income       Decimal?  @db.Decimal(18, 2)
  total_income       Decimal?  @db.Decimal(18, 2)
  pension_deduction  Decimal?  @db.Decimal(18, 2)
  health_insurance   Decimal?  @db.Decimal(18, 2)
  income_tax         Decimal?  @db.Decimal(18, 2)
  tardiness_discount Decimal?  @db.Decimal(18, 2)
  absence_discount   Decimal?  @db.Decimal(18, 2)
