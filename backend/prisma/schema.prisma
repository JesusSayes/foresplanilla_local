  other_deductions   Decimal?  @db.Decimal(18, 2)
  total_deductions   Decimal?  @db.Decimal(18, 2)
  net_pay            Decimal?  @db.Decimal(18, 2)
  payment_date       DateTime? @db.Date
  pdf_url            String?
  status             String?
  notes              String?
  created_by_id      String?
  is_sample          Boolean?
}

