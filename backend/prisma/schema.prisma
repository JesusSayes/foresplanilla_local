model users {
  id                     Int                      @id @default(autoincrement())
  email                  String                   @unique @db.VarChar(255)
  password_hash          String                   @db.VarChar(255)
  role                   String                   @default("admin") @db.VarChar(255)
  full_name              String?                  @db.VarChar(255)
  is_active              Boolean?                 @default(true)
  created_date           DateTime?                @default(now()) @db.Timestamp(6)
  updated_date           DateTime?                @default(now()) @db.Timestamp(6)
  afp                    afp[]
  attendance_incident    attendance_incident[]
  attendance_record      attendance_record[]
  bank                   bank[]
  company_info           company_info[]
  contract               contract[]
  contract_clause        contract_clause[]
  contract_renewal_rule  contract_renewal_rule[]
  contract_template      contract_template[]
  cost_center            cost_center[]
  cost_center_assignment cost_center_assignment[]
  cost_center_change_log cost_center_change_log[]
  department             department[]
  employee               employee[]
  employee_change_log    employee_change_log[]
  holiday                holiday[]
  payroll_concept        payroll_concept[]
  payslip_template       payslip_template[]
  position               position[]
  profession             profession[]
  rmv                    rmv[]
  roles_created          role[]                   @relation("roles_created")
  site                   site[]
  ubigeo                 ubigeo[]
  user_invitation        user_invitation[]
  user_role              user_role[]
  vacation_balance       vacation_balance[]
  work_schedule          work_schedule[]
}

model vacation_request {
  id            Int      @id @default(autoincrement())
  employee_id   String?   @db.VarChar(50)
  created_date  DateTime? @db.Timestamp(6)
  updated_date  DateTime? @db.Timestamp(6)
  status        String?   @db.VarChar(50)
  @@map("vacatin_request") // tabla física existente
}

model vacation_balance {
  employee_id         String?   @db.VarChar(50)
  period_start        DateTime? @db.Date
  period_end          DateTime? @db.Date
  total_entitled_days Decimal?  @db.Decimal(5, 2)
  days_taken          Decimal?  @db.Decimal(5, 2)
  days_pending        Decimal?  @db.Decimal(5, 2)
  days_sold           Decimal?  @db.Decimal(5, 2)
  is_active           Boolean?
  deadline            DateTime? @db.Date
  id                  String    @id @db.VarChar(50)
  created_date        DateTime? @db.Timestamp(6)
  updated_date        DateTime? @db.Timestamp(6)
  created_by_id       Int?
  created_by          String?   @db.VarChar(150)
  is_sample           Boolean?
  users               users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model work_schedule {
  employee_id            String?   @db.VarChar(50)
  department_name        String?   @db.VarChar(150)
  schedule_name          String?   @db.VarChar(150)
  monday_start           String?   @db.VarChar(10)
  monday_end             String?   @db.VarChar(10)
  tuesday_start          String?   @db.VarChar(10)
  tuesday_end            String?   @db.VarChar(10)
  wednesday_start        String?   @db.VarChar(10)
  wednesday_end          String?   @db.VarChar(10)
  thursday_start         String?   @db.VarChar(10)
  thursday_end           String?   @db.VarChar(10)
  friday_start           String?   @db.VarChar(10)
  friday_end             String?   @db.VarChar(10)
  saturday_start         String?   @db.VarChar(10)
  saturday_end           String?   @db.VarChar(10)
  sunday_start           String?   @db.VarChar(10)
  sunday_end             String?   @db.VarChar(10)
  break_duration_minutes Decimal?  @db.Decimal(5, 0)
  tolerance_minutes      Decimal?  @db.Decimal(5, 0)
  is_active              Boolean?
  id                     String    @id @db.VarChar(50)
  created_date           DateTime? @db.Timestamp(6)
  updated_date           DateTime? @db.Timestamp(6)
  created_by_id          Int?
  created_by             String?   @db.VarChar(150)
  is_sample              Boolean?
  users                  users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
