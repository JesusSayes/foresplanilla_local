  gender                         String?   @db.VarChar(10)
  personal_email                 String?   @db.VarChar(150)
  work_email                     String?   @db.VarChar(150)
  phone                          String?   @db.VarChar(50)
  mobile                         String?   @db.VarChar(50)
  address                        String?   @db.VarChar(200)
  district                       String?   @db.VarChar(100)
  province                       String?   @db.VarChar(100)
  department                     String?   @db.VarChar(100)
  company                        String?   @db.VarChar(150)
  position                       String?   @db.VarChar(100)
  position_level                 String?   @db.VarChar(100)
  profession                     String?   @db.VarChar(150)
  department_name                String?   @db.VarChar(150)
  work_unit                      String?   @db.VarChar(100)
  site                           String?   @db.VarChar(150)
  hire_date                      DateTime? @db.Date
  termination_date               DateTime? @db.Date
  contract_type                  String?   @db.VarChar(50)
  base_salary                    Decimal?  @db.Decimal(12, 2)
  bank_name                      String?   @db.VarChar(150)
  bank_account                   String?   @db.VarChar(100)
  cci_account                    String?   @db.VarChar(100)
  cts_bank                       String?   @db.VarChar(150)
  cts_account_number             String?   @db.VarChar(100)
  cts_currency                   String?   @db.VarChar(50)
  pension_system                 String?   @db.VarChar(50)
  afp_id                         String?   @db.VarChar(50)
