generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model access_device {
  id           String    @id(map: "accessdevice_pkey") @db.VarChar(255)
  created_date DateTime? @db.Timestamp(6)
  updated_date DateTime? @db.Timestamp(6)
  created_by   String?
}

model afp {
  name                               String?
  code                               String?
  commission_percentage              Decimal?  @db.Decimal(18, 2)
  obligatory_contribution_percentage Int?
  insurance_percentage               Decimal?  @db.Decimal(18, 2)
  is_active                          Boolean?
  notes                              String?
  id                                 String    @id @db.VarChar(255)
  created_date                       DateTime? @db.Timestamp(6)
  updated_date                       DateTime? @db.Timestamp(6)
  created_by_id                      String?
  created_by                         String?
  is_sample                          Boolean?
}

model attendance_incident {
  employee_id             String?
  attendance_record_id    String?
  incident_date           DateTime? @db.Date
  incident_type           String?
  justification           String?
  supporting_document_url String?
  justified_time_start    String?
  justified_time_end      String?
  full_day_justification  Boolean?
  hours_to_adjust         Decimal?  @db.Decimal(18, 2)
  late_minutes_to_adjust  Int?
  status                  String?
  reviewed_by             String?
  review_date             DateTime? @db.Date
  review_comments         String?
  id                      String    @id(map: "attendanceincident_pkey") @db.VarChar(255)
  created_date            DateTime? @db.Timestamp(6)
  updated_date            DateTime? @db.Timestamp(6)
  created_by_id           String?
  created_by              String?
  is_sample               Boolean?
}

model attendance_record {
  employee_id         String
  date                DateTime  @db.Date
  clock_in            String?
  clock_out           String?
  scheduled_start     String?
  scheduled_end       String?
  worked_hours        Decimal?  @db.Decimal(18, 2)
  is_late             Boolean?
  late_minutes        Int?
  is_absent           Boolean?
  status              String?
  notes               String?
  id                  String    @id(map: "attendancerecord_pkey") @db.VarChar(255)
  created_date        DateTime? @db.Timestamp(6)
  updated_date        DateTime? @db.Timestamp(6)
  created_by_id       String?
  created_by          String?
  is_sample           Boolean?
  regular_hours       Decimal?  @db.Decimal(18, 2)
  overtime_hours_25   Decimal?  @db.Decimal(18, 2)
  overtime_hours_35   Decimal?  @db.Decimal(18, 2)
  overtime_authorized Boolean?

  @@unique([employee_id, date], map: "attendance_record_employee_date_unique")
  @@index([date], map: "idx_attendance_date")
  @@index([employee_id], map: "idx_attendance_employee")
  @@index([status], map: "idx_attendance_status")
}

model bank {
  name          String?
  code          String?
  is_active     Boolean?
  id            String    @id @db.VarChar(255)
  created_date  DateTime? @db.Timestamp(6)
  updated_date  DateTime? @db.Timestamp(6)
  created_by_id String?
  created_by    String?
  is_sample     Boolean?
}

model certificate {
  id           String    @id @db.VarChar(255)
  created_date DateTime? @db.Timestamp(6)
  updated_date DateTime? @db.Timestamp(6)
  created_by   String?
}

model company_info {
  company_name                       String?
  ruc                                String?
  address                            String?
  phone                              String?
  email                              String?
  logo_url                           String?
  legal_representative               String?
  legal_representative_dni           String?
  legal_representative_position      String?
  website                            String?
  is_active                          Boolean?
  id                                 String    @id(map: "companyinfo_pkey") @db.VarChar(255)
  created_date                       DateTime? @db.Timestamp(6)
  updated_date                       DateTime? @db.Timestamp(6)
  created_by_id                      String?
  created_by                         String?
  is_sample                          Boolean?
  legal_representative_signature_url String?
  firmante_gg                        String?
  firmante_delegado                  String?
}

model contract {
  employee_id                 String?
  contract_number             String?
  contract_type               String?
  template_id                 String?
  start_date                  DateTime? @db.Date
  end_date                    DateTime? @db.Date
  position                    String?
  department                  String?
  work_location               String?
  salary                      Int?
  work_schedule               String?
  weekly_hours                Int?
  functions                   String?
  benefits                    String?
  trial_period_days           Int?
  renewable                   Boolean?  @default(false)
  status                      String?
  signed_date                 DateTime? @db.Date
  pdf_url                     String?
  notes                       String?
  id                          String    @id @db.VarChar(255)
  created_date                DateTime? @db.Timestamp(6)
  updated_date                DateTime? @db.Timestamp(6)
  created_by_id               String?
  created_by                  String?
  is_sample                   Boolean?  @default(false)
  activity_cost               Decimal?  @default(0) @db.Decimal
  food_cost                   Decimal?  @default(0) @db.Decimal
  transport_cost              Decimal?  @default(0) @db.Decimal
  is_digitally_signed         Boolean?  @default(false)
  digital_signature_date      DateTime? @db.Timestamp(6)
  digital_signature_image_url String?
  digital_signature_name      String?
  digital_signature_by        String?
}

model contract_clause {
  title          String?
  content        String?
  contract_type  String?
  contract_types Json?     @db.Json
  contract_order Int?
  is_active      Boolean?
  category       String?
  id             String    @id(map: "contractclause_pkey") @db.VarChar(255)
  created_date   DateTime? @db.Timestamp(6)
  updated_date   DateTime? @db.Timestamp(6)
  created_by_id  String?
  created_by     String?
  is_sample      Boolean?
}

model contract_renewal_rule {
  name                   String?
  is_active              Boolean?
  days_before_expiration Int?
  contract_types         Json?     @db.Json
  send_notification      Boolean?
  notification_emails    Json?     @db.Json
  auto_create_draft      Boolean?
  only_renewable         Boolean?
  draft_extension_months Int?
  id                     String    @id(map: "contractrenewalrule_pkey") @db.VarChar(255)
  created_date           DateTime? @db.Timestamp(6)
  updated_date           DateTime? @db.Timestamp(6)
  created_by_id          String?
  created_by             String?
  is_sample              Boolean?
}

model contract_template {
  template_name               String?
  description                 String?
  is_default                  Boolean?
  is_active                   Boolean?
  contract_types              Json?     @db.Json
  company_name                String?
  company_ruc                 String?
  company_address             String?
  company_representative      String?
  company_representative_doc  String?
  introduction_text           String?
  contract_object_text        String?
  functions_intro_text        String?
  duration_indeterminate_text String?
  duration_fixed_text         String?
  trial_period_text           String?
  salary_text                 String?
  schedule_text               String?
  work_location_text          String?
  obligations_text            String?
  benefits_text               String?
  termination_text            String?
  domicile_text               String?
  id                          String    @id(map: "contracttemplate_pkey") @db.VarChar(255)
  created_date                DateTime? @db.Timestamp(6)
  updated_date                DateTime? @db.Timestamp(6)
  created_by_id               String?
  created_by                  String?
  is_sample                   Boolean?
}

model cost_center {
  code          String?
