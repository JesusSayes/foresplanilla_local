generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model access_device {
  id Int @id @default(autoincrement())
}

model afp {
  name                               String?   @db.VarChar(150)
  code                               String?   @db.VarChar(50)
  commission_percentage              Decimal?  @db.Decimal(6, 2)
  obligatory_contribution_percentage Decimal?  @db.Decimal(6, 2)
  insurance_percentage               Decimal?  @db.Decimal(6, 2)
  is_active                          Boolean?
  notes                              String?
  id                                 String    @id @db.VarChar(50)
  created_date                       DateTime? @db.Timestamp(6)
  updated_date                       DateTime? @db.Timestamp(6)
  created_by_id                      Int?
  created_by                         String?   @db.VarChar(150)
  is_sample                          Boolean?
  users                              users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model attendance_incident {
  employee_id             String?   @db.VarChar(50)
  attendance_record_id    String?   @db.VarChar(50)
  incident_date           DateTime? @db.Date
  incident_type           String?   @db.VarChar(100)
  justification           String?
  supporting_document_url String?
  justified_time_start    String?   @db.VarChar(10)
  justified_time_end      String?   @db.VarChar(10)
  full_day_justification  Boolean?
  hours_to_adjust         Decimal?  @db.Decimal(6, 2)
  late_minutes_to_adjust  Decimal?  @db.Decimal(6, 2)
  status                  String?   @db.VarChar(50)
  reviewed_by             String?   @db.VarChar(150)
  review_date             DateTime? @db.Date
  review_comments         String?
  id                      String    @id @db.VarChar(50)
  created_date            DateTime? @db.Timestamp(6)
  updated_date            DateTime? @db.Timestamp(6)
  created_by_id           Int?
  created_by              String?   @db.VarChar(150)
  is_sample               Boolean?
  users                   users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model attendance_record {
  employee_id     String?   @db.VarChar(50)
  date            DateTime? @db.Date
  clock_in        String?   @db.VarChar(10)
  clock_out       String?   @db.VarChar(10)
  scheduled_start String?   @db.VarChar(10)
  scheduled_end   String?   @db.VarChar(10)
  worked_hours    Decimal?  @db.Decimal(6, 2)
  is_late         Boolean?
  late_minutes    Decimal?  @db.Decimal(6, 2)
  is_absent       Boolean?
  status          String?   @db.VarChar(50)
  notes           String?
  id              String    @id @db.VarChar(50)
  created_date    DateTime? @db.Timestamp(6)
  updated_date    DateTime? @db.Timestamp(6)
  created_by_id   Int?
  created_by      String?   @db.VarChar(150)
  is_sample       Boolean?
  users           users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model bank {
  name          String?   @db.VarChar(150)
  code          String?   @db.VarChar(50)
  is_active     Boolean?
  id            String    @id @db.VarChar(50)
  created_date  DateTime? @db.Timestamp(6)
  updated_date  DateTime? @db.Timestamp(6)
  created_by_id Int?
  created_by    String?   @db.VarChar(150)
  is_sample     Boolean?
  users         users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model certificate {
  id Int @id @default(autoincrement())
}

model company_info {
  company_name                  String?   @db.VarChar(200)
  ruc                           String?   @db.VarChar(20)
  address                       String?   @db.VarChar(250)
  phone                         String?   @db.VarChar(50)
  email                         String?   @db.VarChar(150)
  logo_url                      String?
  legal_representative          String?   @db.VarChar(150)
  legal_representative_dni      String?   @db.VarChar(20)
  legal_representative_position String?   @db.VarChar(150)
  website                       String?   @db.VarChar(150)
  is_active                     Boolean?
  id                            String    @id @db.VarChar(50)
  created_date                  DateTime? @db.Timestamp(6)
  updated_date                  DateTime? @db.Timestamp(6)
  created_by_id                 Int?
  created_by                    String?   @db.VarChar(150)
  is_sample                     Boolean?
  users                         users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contract {
  employee_id       String?   @db.VarChar(50)
  contract_number   String?   @db.VarChar(50)
  contract_type     String?   @db.VarChar(50)
  template_id       String?   @db.VarChar(50)
  start_date        DateTime? @db.Date
  end_date          DateTime? @db.Date
  position          String?   @db.VarChar(100)
  department        String?   @db.VarChar(100)
  work_location     String?   @db.VarChar(150)
  salary            Decimal?  @db.Decimal(12, 2)
  work_schedule     String?
  weekly_hours      Decimal?  @db.Decimal(5, 2)
  functions         String?
  benefits          String?
  trial_period_days Decimal?  @db.Decimal(5, 0)
  renewable         Boolean?
  status            String?   @db.VarChar(50)
  signed_date       DateTime? @db.Date
  pdf_url           String?
  notes             String?
  id                String    @id @db.VarChar(50)
  created_date      DateTime? @db.Timestamp(6)
  updated_date      DateTime? @db.Timestamp(6)
  created_by_id     Int?
  created_by        String?   @db.VarChar(150)
  is_sample         Boolean?
  users             users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contract_clause {
  title          String?   @db.VarChar(200)
  content        String?
  type           String?   @db.VarChar(50)
  contract_types Json?
  order          Decimal?  @db.Decimal(5, 0)
  is_active      Boolean?
  category       String?   @db.VarChar(50)
  id             String    @id @db.VarChar(50)
  created_date   DateTime? @db.Timestamp(6)
  updated_date   DateTime? @db.Timestamp(6)
  created_by_id  Int?
  created_by     String?   @db.VarChar(150)
  is_sample      Boolean?
  users          users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contract_renewal_rule {
  name                   String?   @db.VarChar(200)
  is_active              Boolean?
  days_before_expiration Decimal?  @db.Decimal(5, 0)
  contract_types         Json?
  send_notification      Boolean?
  notification_emails    Json?
  auto_create_draft      Boolean?
  only_renewable         Boolean?
  draft_extension_months Decimal?  @db.Decimal(5, 0)
  id                     String    @id @db.VarChar(50)
  created_date           DateTime? @db.Timestamp(6)
  updated_date           DateTime? @db.Timestamp(6)
  created_by_id          Int?
  created_by             String?   @db.VarChar(150)
  is_sample              Boolean?
  users                  users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contract_template {
  template_name               String?   @db.VarChar(200)
  description                 String?
  is_default                  Boolean?
  is_active                   Boolean?
  contract_types              Json?
  company_name                String?   @db.VarChar(200)
  company_ruc                 String?   @db.VarChar(20)
  company_address             String?   @db.VarChar(250)
  company_representative      String?   @db.VarChar(150)
  company_representative_doc  String?   @db.VarChar(100)
  introduction_text           String?
  contract_object_text        String?
  functions_intro_text        String?
  duration_indeterminate_text String?
  duration_fixed_text         String?
  trial_period_text           String?
  salary_text                 String?
  schedule_text               String?
  work_location_text          String?
  obligations_text            String?
  benefits_text               String?
  termination_text            String?
  domicile_text               String?
  id                          String    @id @db.VarChar(50)
  created_date                DateTime? @db.Timestamp(6)
  updated_date                DateTime? @db.Timestamp(6)
  created_by_id               Int?
  created_by                  String?   @db.VarChar(150)
  is_sample                   Boolean?
  users                       users?    @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cost_center {
  code          String?   @db.VarChar(50)
  name          String?   @db.VarChar(200)
