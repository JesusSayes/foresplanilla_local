}

model cost_center_assignment {
  cost_center_id  String?   @db.VarChar(50)
  assignment_type String?   @db.VarChar(50)
  employee_id     String?   @db.VarChar(50)
  department_name String?   @db.VarChar(150)
  percentage      Decimal?  @db.Decimal(5, 2)
  start_date      DateTime? @db.Date
  end_date        DateTime? @db.Date
