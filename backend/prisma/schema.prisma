  cuspp                          String?   @db.VarChar(50)
  worker_type                    String?   @db.VarChar(50)
  tax_residence                  String?   @db.VarChar(50)
  photo_url                      String?
  status                         String?   @db.VarChar(50)
  role                           String?   @db.VarChar(50)
  managed_team_ids               Json?
  supervisor_id                  String?   @db.VarChar(50)
