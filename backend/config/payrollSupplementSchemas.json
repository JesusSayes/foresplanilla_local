        "type": "integer"
      },
      "payroll_type": {
        "type": "string",
        "enum": [
          "Mensual",
          "Adicional"
        ],
        "default": "Mensual"
      },
      "status": {
        "type": "string",
        "enum": [
          "Pendiente",
          "Aprobada",
          "Aplicada",
          "Pagada",
          "Rechazada",
          "Revertida"
        ],
        "default": "Pendiente"
      },
      "approved_by": {
        "type": "string"
      },
      "approved_date": {
        "type": "string",
        "format": "date-time"
      },
      "payment_reference": {
        "type": "string"
      },
      "applied_to_payslip_id": {
        "type": "string"
      },
      "applied_date": {
        "type": "string",
        "format": "date-time"
      },
      "reverted_by": {
        "type": "string"
      },
      "reverted_date": {
        "type": "string",
        "format": "date-time"
      },
      "revert_reason": {
        "type": "string"
      },
      "rejected_by": {
        "type": "string"
      },
      "rejected_date": {
        "type": "string",
        "format": "date-time"
      },
      "rejection_reason": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "created_by": {
        "type": "string"
      }
    },
    "required": [
      "employee_id",
      "days_sold",
      "amount",
      "sale_date"
    ]
  }
}
